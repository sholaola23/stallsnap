# Copy to .env and fill in. Never commit .env.
MODEL_API_KEY=
# Paid calls are off unless this is 1.
STALLSNAP_LIVE=0
# Most paid calls one command may make.
STALLSNAP_MAX_CALLS=10
# Stop when today's estimated spend (UTC day, this machine) would pass this.
STALLSNAP_DAILY_CAP_USD=2

# WhatsApp (see docs/whatsapp-setup.md). Set all of these or none.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Verified test recipients, with country codes, separated by commas.
ALLOWED_NUMBERS=
# The server's public address, used in the catalogue links.
PUBLIC_URL=
# Heading on the catalogue page. Never a phone number.
CATALOGUE_STALL_NAME=
